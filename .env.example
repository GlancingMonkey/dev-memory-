# Backend running inside the Dev Container.
# Replace CHANGE_ME locally with the password of your development database.
# Current Compose service/db/user: db / capstone / capstone.
DATABASE_URL=postgresql://capstone:CHANGE_ME@db:5432/capstone

# If the Backend itself runs on Windows, the host would be 127.0.0.1:
# DATABASE_URL=postgresql://capstone:CHANGE_ME@127.0.0.1:5432/capstone

# Keep actual credentials in the ignored .env file; do not commit that file.

# Server default for POST /ask and AI POST /study/* when no personal key is supplied.
# Leave this empty if you use only snippet saving and semantic search.
OPENAI_API_KEY=

# Optional models for personal Claude/Gemini keys from Extension headers.
# Actual personal keys stay in VS Code SecretStorage, not these settings.
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional isolated study execution. Build its image before enabling:
# docker build -t code-memory-study-runner:local backend/runner
# The Backend must have access to the trusted Docker daemon. No host-code fallback.
STUDY_RUNNER_ENABLED=false
STUDY_RUNNER_IMAGE=code-memory-study-runner:local
