# Backend running inside the Dev Container.
# Replace CHANGE_ME locally with the password of your development database.
# Current Compose service/db/user: db / capstone / capstone.
DATABASE_URL=postgresql://capstone:CHANGE_ME@db:5432/capstone

# If the Backend itself runs on Windows, the host would be 127.0.0.1:
# DATABASE_URL=postgresql://capstone:CHANGE_ME@127.0.0.1:5432/capstone

# Keep actual credentials in the ignored .env file; do not commit that file.
